{
  "name": "dbsder-api",
  "description": "API permettant l'interraction avec la base de donnée dbsder",
  "author": "Cour de cassation",
  "license": "MIT",
  "scripts": {
    "start:watch": "nodemon --watch 'src/**' --ext 'ts,json' --exec 'npx ts-node -r tsconfig-paths/register src/server.ts'",
    "start": "node dist/server.js",
    "start:docker": "docker compose up -d",
    "stop:docker": "docker compose stop",
    "build:watch": "tsc --watch",
    "build": "tsc --build && tsc-alias",
    "format": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "fix": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write",
    "test": "jest --detectOpenHandles -c jest.config.js",
    "types:build": "tsc -p tsconfig.types.json && cp package.types.json dist-types/package.json",
    "types:link": "npm run types:build && cd dist-types && npm link"
  },
  "dependencies": {
    "axios": "1.21.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.9",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}